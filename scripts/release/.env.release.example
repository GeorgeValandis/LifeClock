# App Store Connect API key
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXX.p8

# Numeric App Store Connect app id for the iOS app
APPLE_APP_ID=

# Optional asc auth profile name stored in macOS Keychain
ASC_PROFILE_NAME=LifeClock

# Project defaults for the iOS app target
APP_PROJECT=LifeClock.xcodeproj
APP_SCHEME=LifeClock
APP_CONFIGURATION=Release
APP_PLATFORM=IOS
XCODE_DESTINATION=generic/platform=iOS
APPLE_TEAM_ID=LPPZFWPAN7

# Optional export/archive behavior
ARTIFACT_DIR=.asc/artifacts
ALLOW_PROVISIONING_UPDATES=false

# Optional TestFlight defaults
ASC_TESTFLIGHT_GROUPS=
ASC_TESTFLIGHT_NOTES=
ASC_TESTFLIGHT_LOCALE=en-US

# Optional App Store defaults
ASC_APPSTORE_SUBMIT=false
ASC_WAIT_TIMEOUT=45m
APPSTORE_EXPORT_METHOD=app-store-connect
APPSTORE_EXPORT_SIGNING_STYLE=automatic

# Optional App Store listing defaults
APPSTORE_METADATA_SOURCE_DIR=appstore/metadata
APPSTORE_PRIMARY_LOCALE=en-US
APPSTORE_PRIMARY_CATEGORY=LIFESTYLE
APPSTORE_SECONDARY_CATEGORY=HEALTH_AND_FITNESS
APPSTORE_REVIEW_FIRST_NAME=Georgios
APPSTORE_REVIEW_LAST_NAME=Avenidis
APPSTORE_REVIEW_EMAIL=support@georgevalandis.com
APPSTORE_REVIEW_PHONE=+49 173 4625411
APPSTORE_DEMO_ACCOUNT_NAME=Not required
APPSTORE_DEMO_ACCOUNT_PASSWORD=Not required
APPSTORE_REVIEW_NOTES_FILE=appstore/review/notes.txt
APPSTORE_AGE_RATING_INFO_URL=https://georgevalandis.com/privacy-datenschutzerklaerung/
APPSTORE_SCREENSHOT_DIR=.asc/screenshots
APPSTORE_IPHONE_DEVICE=iPhone 17 Pro Max
APPSTORE_IPHONE_DEVICE_TYPE=IPHONE_69
APPSTORE_IPAD_DEVICE=iPad Pro 13-inch (M4)
APPSTORE_IPAD_DEVICE_TYPE=IPAD_PRO_3GEN_129
APPSTORE_SIM_RUNTIME=26.0
APPSTORE_IAP_PRODUCT_ID=com.GA.LifeClock.lifetime
APPSTORE_APP_BUNDLE_ID=com.GA.LifeClock
APPSTORE_WIDGET_BUNDLE_ID=com.GA.LifeClock.widget
APPSTORE_APP_PROFILE_NAME=
APPSTORE_WIDGET_PROFILE_NAME=
